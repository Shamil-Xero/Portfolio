# Portfolio Backend Environment Variables

# Server port (Render sets this automatically)
PORT=3001

# Admin key for accessing protected endpoints (messages, analytics)
ADMIN_KEY=change-this-to-a-secret-key

# OpenAI API key for AI chatbot (optional — falls back to predefined responses)
# OPENAI_API_KEY=sk-your-key-here

# Database path (optional — defaults to ./data.db)
# DB_PATH=./data.db
